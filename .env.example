ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Voice mode (--voice) tuning — see README's "Tuning the recording volume
# threshold" section.
# VOICE_SILENCE_THRESHOLD=3%
# VOICE_SILENCE_DURATION=2.0
# VOICE_MAX_RECORDING_SECONDS=20

# Voice mode TTS provider — defaults to OpenAI if unset. STT (Whisper) is
# unaffected either way.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
